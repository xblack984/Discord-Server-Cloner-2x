# Copy this file to xbox_agent/.env and fill it in (setup.bat does the copy for you).
# '#' starts a comment. Variables already set in the real environment win over this file.

# --- Dashboard: two DIFFERENT secrets ---------------------------------------------------------
# generate each with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
XBOX_AGENT_DASHBOARD_URL=http://127.0.0.1:8000
XBOX_AGENT_DASHBOARD_TOKEN=
DASHBOARD_ADMIN_TOKEN=
# Dashboard address; if you change the port, change XBOX_AGENT_DASHBOARD_URL above to match
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8000

# --- Vision backend: auto | gemini | deepseek | claude ---------------------------------------------------
XBOX_AGENT_VISION_PROVIDER=auto
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# XBOX_AGENT_DEEPSEEK_MODEL=deepseek-flash
# XBOX_AGENT_DEEPSEEK_THINKING=off
# XBOX_AGENT_CLAUDE_MODEL=claude-opus-5-5
# XBOX_AGENT_CLAUDE_EFFORT=low
# XBOX_AGENT_CLAUDE_FALLBACKS=1

# --- Remote Play page: the agent opens it itself, in its own new browser window ----------------
XBOX_AGENT_PLAY_URL=https://www.xbox.com/de-DE/play/consoles
# Direct link to YOUR console: skips the consoles page and the connect button. Put your own console id
# in it and edit the line above instead of adding a second one. Do not share it.
# XBOX_AGENT_PLAY_URL=https://www.xbox.com/de-DE/play/consoles/launch/<your-console-id>
# 1 = open the page in a new window (recommended). 0 = use a window you opened yourself.
XBOX_AGENT_OPEN_PLAY_URL=1
# auto (Chrome, else Edge) | chrome | edge | full path to chrome.exe / msedge.exe
XBOX_AGENT_BROWSER=auto
# The Chrome profile you signed in to Xbox with ("Default", "Profile 1", ... see chrome://version, "Profile Path").
# Empty = the last used profile. Sign in once with:  run_agent.bat --login
# XBOX_AGENT_BROWSER_PROFILE=Default
# Seconds the agent waits for you to sign in to Microsoft in the browser before it asks for help
# XBOX_AGENT_WEB_LOGIN_TIMEOUT_S=600
# Text on the page's connect button. German page: verbinden. English page: connect
XBOX_AGENT_CONSOLE_LABELS=verbinden,connect

# --- Browser window and OCR -------------------------------------------------------------------
# Used only to reuse a window that is already open: part of its title. Windows whose title
# contains a word from EXCLUDE (the dashboard tab) are never used.
XBOX_AGENT_WINDOW_TITLE=Xbox
# XBOX_AGENT_WINDOW_EXCLUDE=XboxAgent
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Safety (keep these while trialling) ------------------------------------------------------
# Profile removal never runs unless this is 1 (and the dashboard still has to confirm it)
XBOX_AGENT_ALLOW_DELETE=0
# Stop and ask on every invalid / already-used code instead of moving on to the next one
XBOX_AGENT_PAUSE_ON_CODE_ERROR=1

# --- Fewer stops: decide once instead of being asked every session ----------------------------
# A game is on the console screen:  ask (default) | start (press A) | close | keep (open the Guide over it)
# XBOX_AGENT_ON_GAME_RUNNING=keep
# The console already has your MAIN account signed in:
#   add (default) = keep the main account, add a NEW account (Guide > Profile & system > Add or switch > Add new),
#                   sign in with a code, and at the end sign out / remove only the new account
#   use           = work with the signed-in profile (it is never signed out or removed)
#   ask           = ask on the dashboard every time
# XBOX_AGENT_ON_SIGNED_IN=add
# If your console words the menu differently, adjust the path ("a|b" means a or b; German and Arabic included):
# XBOX_AGENT_ADD_ACCOUNT_PATH=profile|profil,add or switch|hinzufügen oder wechseln,add new|neu hinzufügen
# Profile removal has no "decide in advance" setting on purpose: it always needs your typed confirmation.

# --- Resilience -------------------------------------------------------------------------------
# Tries per vision call: a rate limit, timeout, 5xx or unusable answer is retried with backoff (1 = never retry)
# XBOX_AGENT_VISION_ATTEMPTS=3
# Extra looks at a screen the vision model can not recognise (a transition or a toast) before giving up
# XBOX_AGENT_SECOND_LOOKS=2

# --- Menu labels: tune them with  python -m xbox_agent --inspect  ------------------------------
# Comma-separated; each item is a substring of what is on screen. Case, (R)/(TM) signs and Arabic spelling
# variants are ignored. The defaults already cover English, German and Arabic consoles. Only the Arabic
# "الصفحة الرئيسية", "ألعابي" and "قطع الاتصال" were checked on a real screen: if a German/Arabic word is
# wrong, put the exact word you see here. In the two *_PATH settings "a|b" means "a or b".
# XBOX_AGENT_LOGIN_LABELS=another device,with a code,use a code,anderen gerät,mit einem code,mit code,جهاز آخر,باستخدام رمز
# XBOX_AGENT_SIGNIN_LABELS=sign in,anmelden,تسجيل الدخول
# XBOX_AGENT_REDEEM_PATH=store|متجر,redeem|einlösen|استرداد
# XBOX_AGENT_LIBRARY_LABELS=my games,library,meine spiele,bibliothek,ألعابي,مكتبة
# XBOX_AGENT_HOME_LABELS=home,startseite,الصفحة الرئيسية
# XBOX_AGENT_PLAY_LABELS=play,launch,resume,spielen,starten,fortsetzen,تشغيل,استئناف
# XBOX_AGENT_QUIT_LABELS=quit,exit,beenden,إنهاء
# XBOX_AGENT_SIGNOUT_LABELS=sign out,abmelden,تسجيل الخروج
# XBOX_AGENT_PROFILE_LABELS=profile,profil,الملف الشخصي
# XBOX_AGENT_DELETE_PATH=profile|profil|الملف الشخصي,settings|einstellungen|إعدادات,account|konto|حساب,remove accounts|konten entfernen|إزالة الحسابات
# The game: matched against titles ("Modern Warfare" yes; II, III, 2, 3 and Warzone no)
# XBOX_AGENT_GAME_MATCH=modern\s*warfare
# XBOX_AGENT_GAME_EXCLUDE=modern\s*warfare\W*\s*(ii|iii|2|3)\b|warzone
# XBOX_AGENT_LOGIN_CODE_REGEX=\b[A-Z0-9]{6,10}\b
