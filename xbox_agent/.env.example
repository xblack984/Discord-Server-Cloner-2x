# Copy this file to xbox_agent/.env and fill it in (setup.bat does the copy for you).
# '#' starts a comment. Variables already set in the real environment win over this file.

# --- Dashboard: two DIFFERENT secrets ---------------------------------------------------------
# generate each with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
XBOX_AGENT_DASHBOARD_URL=http://127.0.0.1:8000
XBOX_AGENT_DASHBOARD_TOKEN=
DASHBOARD_ADMIN_TOKEN=
# Dashboard address; if you change the port, change XBOX_AGENT_DASHBOARD_URL above to match
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8000

# --- Vision backend: auto | gemini | deepseek | claude ---------------------------------------------------
XBOX_AGENT_VISION_PROVIDER=auto
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# XBOX_AGENT_DEEPSEEK_MODEL=deepseek-flash
# XBOX_AGENT_DEEPSEEK_THINKING=off
# XBOX_AGENT_CLAUDE_MODEL=claude-opus-5-5
# XBOX_AGENT_CLAUDE_EFFORT=low
# XBOX_AGENT_CLAUDE_FALLBACKS=1

# --- Remote Play page: the agent opens it itself, in its own new browser window ----------------
XBOX_AGENT_PLAY_URL=https://www.xbox.com/de-DE/play/consoles
# Direct link to YOUR console: skips the consoles page and the connect button. Put your own console id
# in it and edit the line above instead of adding a second one. Do not share it.
# XBOX_AGENT_PLAY_URL=https://www.xbox.com/de-DE/play/consoles/launch/<your-console-id>
# 1 = open the page in a new window (recommended). 0 = use a window you opened yourself.
XBOX_AGENT_OPEN_PLAY_URL=1
# auto (Chrome, else Edge) | chrome | edge | full path to chrome.exe / msedge.exe
XBOX_AGENT_BROWSER=auto
# The Chrome profile you signed in to Xbox with ("Default", "Profile 1", ... see chrome://version, "Profile Path").
# Empty = the last used profile. Sign in once with:  run_agent.bat --login
# XBOX_AGENT_BROWSER_PROFILE=Default
# Seconds the agent waits for you to sign in to Microsoft in the browser before it asks for help
# XBOX_AGENT_WEB_LOGIN_TIMEOUT_S=600
# Text on the page's connect button. German page: verbinden. English page: connect
XBOX_AGENT_CONSOLE_LABELS=verbinden,connect

# --- Browser window and OCR -------------------------------------------------------------------
# Used only to reuse a window that is already open: part of its title. Windows whose title
# contains a word from EXCLUDE (the dashboard tab) are never used.
XBOX_AGENT_WINDOW_TITLE=Xbox
# XBOX_AGENT_WINDOW_EXCLUDE=XboxAgent
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Safety (keep these while trialling) ------------------------------------------------------
# Profile removal never runs unless this is 1 (and the dashboard still has to confirm it)
XBOX_AGENT_ALLOW_DELETE=0
# Stop and ask on every invalid / already-used code instead of moving on to the next one
XBOX_AGENT_PAUSE_ON_CODE_ERROR=1

# --- Menu labels: tune them with  python -m xbox_agent --inspect  ------------------------------
# Comma-separated, matched case-insensitively as substrings of what is on screen
# XBOX_AGENT_LOGIN_LABELS=another device,with a code,use a code
# XBOX_AGENT_REDEEM_PATH=store,redeem
# XBOX_AGENT_LIBRARY_LABELS=my games,library
# XBOX_AGENT_DELETE_PATH=profile,settings,account,remove accounts
# XBOX_AGENT_GAME_MATCH=modern\s*warfare
# XBOX_AGENT_GAME_EXCLUDE=modern\s*warfare\s*(ii|iii|2|3)\b|warzone
# XBOX_AGENT_LOGIN_CODE_REGEX=\b[A-Z0-9]{6,10}\b
